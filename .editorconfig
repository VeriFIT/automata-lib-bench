# https://editorconfig.org

root = true

[*]
end_of_line = lf
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,toml,yml,yaml,nix,html,css}]
indent_size = 2

[**/Makefile]
indent_style = tab

# clang-format (LLVM style) and cmake-format
[{*.{cc,hh},CMakeLists.txt,*.cmake}]
indent_size = 2

# shfmt
[{*.sh,.envrc}]
switch_case_indent = true
