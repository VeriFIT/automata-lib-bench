# https://editorconfig.org

root = true

[*]
end_of_line = lf
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[{*.cc,*.hh,*.c,*.h,*.just,justfile,Makefile,CMakeLists.txt,*.cmake,*.cmake.in}]
indent_style = tab

[{*.{md,toml,yml,yaml,nix,html,css,json},.clangd,.clang-format,.clang-tidy}]
indent_size = 2

# shfmt
[{*.sh,.envrc}]
switch_case_indent = true
